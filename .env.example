# --- LLM ---
OPENAI_API_KEY=sk-...
# Any OpenAI-compatible endpoint works (OpenRouter, GLM, Ollama...)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# mock | openai | hybrid  (hybrid: first REAL_BRAIN_COUNT agents get real brains)
BRAIN_MODE=mock
REAL_BRAIN_COUNT=3

# --- World ---
PORT=8080
MAX_AGENTS=20
MIN_POPULATION=5
DECISION_INTERVAL_MS=15000
MAX_CONCURRENT_LLM=4
LLM_RPM_CAP=60
DAILY_USD_BUDGET=15

# --- Admin ---
ADMIN_PASSWORD=change-me

# --- X / Twitter ---
# mock  = no network; mock tweets come from the admin panel, posts just log
# live  = post maze utterances to X and poll real mentions/replies
X_MODE=mock
X_HANDLE=backrooms
# numeric account id (for the mentions endpoint) + app bearer token (reads)
X_USER_ID=
X_BEARER_TOKEN=
# OAuth 1.0a user-context keys (needed to POST as our account)
X_APP_KEY=
X_APP_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# how often to poll mentions (ms) and whether maze tweets auto-post outward
X_POLL_MS=90000
X_POST_MAZE_TWEETS=true
