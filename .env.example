# --- LLM ---
OPENAI_API_KEY=sk-...
# Any OpenAI-compatible endpoint works (OpenRouter, GLM, Ollama...)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# mock | openai | hybrid  (hybrid: first REAL_BRAIN_COUNT agents get real brains)
BRAIN_MODE=mock
REAL_BRAIN_COUNT=3

# --- World ---
PORT=8080
MAX_AGENTS=100
MIN_POPULATION=5
DECISION_INTERVAL_MS=15000
MAX_CONCURRENT_LLM=4
LLM_RPM_CAP=60
DAILY_USD_BUDGET=15

# --- Admin ---
ADMIN_PASSWORD=change-me

# --- X / Twitter (ported from the universe project) ---
# MASTER SWITCH: mock = no network at all (mentions come from the admin panel,
# posts just log). live = the reader/poster below turn on per their keys.
X_MODE=mock
X_HANDLE=nightrooms

# READER (incoming mentions) — official API app bearer token.
X_BEARER_TOKEN=
X_USER_ID=            # optional; else looked up from the handle and cached
X_READ_POLL_MIN=2     # minutes between mention polls

# POSTER (outgoing tweets, official API v2 + OAuth 1.0a).
# To go live: fill the four keys, set X_POST=on, X_MODE=live, restart.
X_POST=off
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# Premium allows long-form (up to 25000). Free/Basic tier: set this to 280.
X_MAX_POST_LEN=4000
